---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="contenedor-pagina">
    <h1>Planes y Servicios</h1>

    <div class="planes">
      <div class="plan">
        <p>Ideal para estudiantes.</p>
        <h3>$0 CLP Registrate</h3>
      </div>

      <div class="plan">
        <h2>Profesional</h2>
        <p>Proyectos ilimitados.</p>
        <h3>$9.990 CLP/mes</h3>
      </div>

      <div class="plan">
        <h2>Empresa</h2>
        <p>Integraciones y soporte premium.</p>
        <h3>$29.990 CLP/mes</h3>
      </div>
    </div>

    <div class="comparativa-planes">
      <div class="columna-detalle">
        <h4>INCLUIDO EN LA VERSIÓN ESTUDIANTE:</h4>
        <ul>
          <li>Tarjetas y listas ilimitadas</li>
          <li>Hasta 5 tableros Kanban por espacio</li>
          <li>Etiquetas de colores y fechas límite</li>
          <li>Adjuntos de hasta 10 MB por archivo</li>
          <li>Registro de actividad básico</li>
          <li>Acceso desde web y aplicación móvil</li>
        </ul>
      </div>

      <div class="columna-detalle">
        <h4>TODO LO QUE INCLUYE PROFESIONAL, ADEMÁS DE:</h4>
        <ul>
          <li>Tableros Kanban ilimitados</li>
          <li>Vistas de Calendario y Cronología</li>
          <li>Campos personalizados en tarjetas</li>
          <li>Adjuntos de hasta 250 MB por archivo</li>
          <li>Automatización de tareas repetitivas</li>
          <li>Reportes avanzados de productividad</li>
        </ul>
      </div>

      <div class="columna-detalle">
        <h4>TODO LO INCLUIDO EN EMPRESA, MÁS:</h4>
        <ul>
          <li>Espacios de trabajo ilimitados</li>
          <li>Permisos y roles para toda la empresa</li>
          <li>Integraciones con Slack, Drive y GitHub</li>
          <li>Soporte técnico prioritario 24/7</li>
          <li>Exportación avanzada de datos y copias</li>
          <li>Inicio de sesión único (SSO) y seguridad</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
