---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="contenedor-pagina">
    <h1>Quiénes Somos</h1>

    <img
      src="/images/NovaApps.png" alt="Equipo Novaapps"
      width="600"
    />

    <div class="planes">
      <div class="plan">
        <h2>Nuestra Misión</h2>
        <p>Simplificar y facilitar la organización visual de proyectos para estudiantes, emprendedores y empresas.</p>
        <h3>Simplicidad</h3>
      </div>

      <div class="plan">
        <h2>Metodología Kanban</h2>
        <p>Tableros intuitivos inspirados en flujos ágiles para que cada equipo avance sin perder el foco.</p>
        <h3>Productividad</h3>
      </div>
  

      <div class="plan">
        <h2>Crece a tu ritmo</h2>
        <p>Desde tableros gratuitos hasta herramientas empresariales con soporte prioritario.</p>
        <h3>Escalabilidad</h3>
      </div>
    </div>
  </section>
</Layout>
